# Base URL for the Robinhood asset registry API.
# Optional — defaults to https://api.robinhood.com when unset.
# Overriding is mainly useful for local testing against a mock server.
ROBINHOOD_API_BASE_URL=https://api.robinhood.com

# Timeout (milliseconds) for outbound requests to the Robinhood API.
# Optional — defaults to 8000 when unset.
ROBINHOOD_API_TIMEOUT_MS=8000

# Base URL for the Dexscreener API.
# Optional — defaults to https://api.dexscreener.com when unset.
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com

# Timeout (milliseconds) for outbound requests to the Dexscreener API.
# Optional — defaults to 8000 when unset.
DEXSCREENER_API_TIMEOUT_MS=8000

# Max simultaneous Dexscreener requests during a Phase 4 bulk market
# snapshot build. Optional — defaults to 2 when unset. See README
# "Phase 4: Bulk Market Snapshot and Liquidity Leaderboard" for the
# rate-limit evidence this default is chosen against.
DEXSCREENER_BULK_CONCURRENCY=2

# Minimum spacing (milliseconds) between successive Dexscreener request
# starts during a bulk snapshot build — this, not concurrency, is what
# actually caps throughput (default 1000ms => ~60 requests/minute
# ceiling). Optional — defaults to 1000 when unset.
DEXSCREENER_REQUEST_INTERVAL_MS=1000

# How long (milliseconds) a market liquidity snapshot stays "fresh"
# before the next request triggers a rebuild. Must comfortably exceed
# the actual snapshot build time (~3.3 minutes measured at the defaults
# above for ~194 assets) — see README. Optional — defaults to 300000
# (5 minutes) when unset.
MARKET_SNAPSHOT_TTL_MS=300000
